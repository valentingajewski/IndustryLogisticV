<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>LSOL</AssemblyName>
    <RootNamespace>LSOL</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet">
      <HintPath>scripthookdotnet\ScriptHookVDotNet.asi</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>scripthookdotnet\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>scripthookdotnet\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LSOL.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Runtime output keeps LSOL.dll and LSOL.ini at the root, while LSOL content lives under LSOL\. -->
  <Target Name="PrepareNestedLsolRuntimeOutput" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)LSOL" />
    <MakeDir Directories="$(OutDir)LSOL\LSOL_Config" />
    <MakeDir Directories="$(OutDir)LSOL\LSOL_Addons" />
    <MakeDir Directories="$(OutDir)LSOL\LSOLSaves" />
    <RemoveDir Directories="$(OutDir)missions" Condition="Exists('$(OutDir)missions')" />
    <RemoveDir Directories="$(OutDir)configs" Condition="Exists('$(OutDir)configs')" />
    <RemoveDir Directories="$(OutDir)LSOL_Config" Condition="Exists('$(OutDir)LSOL_Config')" />
    <RemoveDir Directories="$(OutDir)LSOL_Addons" Condition="Exists('$(OutDir)LSOL_Addons')" />
    <RemoveDir Directories="$(OutDir)LSOL\LSOL_Config\LSOL_Config" Condition="Exists('$(OutDir)LSOL\LSOL_Config\LSOL_Config')" />
    <RemoveDir Directories="$(OutDir)LSOL\LSOL_Addons\LSOL_Addons" Condition="Exists('$(OutDir)LSOL\LSOL_Addons\LSOL_Addons')" />
    <ItemGroup>
      <_LsolRuntimeConfigFiles Include="LSOL_Config\**\*" />
      <_LsolRuntimeAddonFiles Include="LSOL_Addons\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LsolRuntimeConfigFiles)"
          DestinationFiles="@(_LsolRuntimeConfigFiles->'$(OutDir)LSOL\%(Identity)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_LsolRuntimeAddonFiles)"
          DestinationFiles="@(_LsolRuntimeAddonFiles->'$(OutDir)LSOL\%(Identity)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
